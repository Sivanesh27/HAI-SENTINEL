# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME=HAI-Sentinel
API_V1_STR=/api

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# PostgreSQL: postgresql://user:password@localhost:5432/hai_sentinel
# SQLite fallback (default for local development & zero-setup demo):
DATABASE_URL=sqlite:///./hai_sentinel.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Model Paths
MODEL_DIR=./models
DATA_DIR=./data
